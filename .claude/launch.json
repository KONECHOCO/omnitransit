{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "omnitransit-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "omnitransit-own-motis",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5175",
        "--strictPort",
        "--mode",
        "ownmotis"
      ],
      "port": 5175
    },
    {
      "name": "omnitransit-prod-data",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5176",
        "--strictPort",
        "--mode",
        "production"
      ],
      "port": 5176
    }
  ]
}
